<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneDocument.Tools.TextCompare</RootNamespace>
    <AssemblyName>TextCompare</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- A tool that reads documents we generate or fetched ourselves; the comparator's advisories stay visible as warnings here. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Comparator, used through its public API only. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneDocument/OneDocument.csproj" />
  </ItemGroup>

</Project>
