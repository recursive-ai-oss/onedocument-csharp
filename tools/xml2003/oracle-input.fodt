 <office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"><style:header><text:p>Page header text</text:p></style:header><style:footer><text:p>Page footer text</text:p></style:footer></style:master-page></office:master-styles>
 <office:body><office:text>
  <text:tracked-changes><text:changed-region text:id="ct1"><text:insertion><office:change-info><dc:creator>Rev</dc:creator><dc:date>2024-02-03T04:05:06</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region text:id="ct2"><text:deletion><office:change-info><dc:creator>Rev</dc:creator><dc:date>2024-02-03T04:06:06</dc:date></office:change-info><text:p>removed text</text:p></text:deletion></text:changed-region></text:tracked-changes>
  <text:h text:outline-level="1">Heading one</text:h>
  <text:p text:style-name="C">Plain, <text:span text:style-name="B">bold red</text:span> and <text:a xlink:href="https://example.com/">a link</text:a>.<text:bookmark text:name="mark1"/></text:p>
  <text:p>Note here<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>The footnote text.</text:p></text:note-body></text:note> and a comment<office:annotation office:name="c1"><dc:creator>Reviewer</dc:creator><dc:date>2024-01-02T03:04:05</dc:date><text:p>Comment body</text:p></office:annotation>.</text:p>
  <text:p>Some <text:change-start text:change-id="ct1"/>inserted<text:change-end text:change-id="ct1"/> and <text:change text:change-id="ct2"/>kept words.</text:p>
  <text:list text:style-name="L1"><text:list-item><text:p>first item</text:p></text:list-item><text:list-item><text:p>second item</text:p></text:list-item></text:list>
  <table:table table:name="Table1" table:style-name="T"><table:table-column table:style-name="T.A" table:number-columns-repeated="2"/><table:table-row><table:table-cell table:style-name="T.A1" office:value-type="string" table:number-columns-spanned="2"><text:p>spanning</text:p></table:table-cell><table:covered-table-cell/></table:table-row><table:table-row><table:table-cell table:style-name="T.A1" office:value-type="string"><text:p>r2c1</text:p></table:table-cell><table:table-cell table:style-name="T.A1" office:value-type="string"><text:p>r2c2</text:p></table:table-cell></table:table-row></table:table>
  <text:p>Picture: <draw:frame draw:name="pic" svg:width="1in" svg:height="1in" text:anchor-type="as-char"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==</office:binary-data></draw:image></draw:frame></text:p>
