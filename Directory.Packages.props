<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Family libraries the shipped packages use, at published versions. -->
    <PackageVersion Include="RecursiveAI.OneArchive" Version="1.2.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneMath" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OneRender" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Pdf" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Image" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts.Noto.Arabic" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts.Noto.Hebrew" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts.Noto.Thai" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts.Cjk" Version="1.3.3" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.11.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneImage.Text" Version="1.11.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneImage.Metafile" Version="1.11.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneImage.Svg" Version="1.11.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.18.0" />
    <PackageVersion Include="RecursiveAI.OneFont" Version="1.4.0" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
    <!-- Test, fuzz and benchmark projects only. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Comparator libraries, run black-box through their public APIs. Referenced only from bench, tests and tools projects. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="NPOI" Version="2.7.6" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="MiniExcel" Version="1.46.0" />
    <PackageVersion Include="Sylvan.Data.Excel" Version="0.5.8" />
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="EPPlus" Version="4.5.3.3" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <!-- The POCO source generator's compile-time dependency. It is an analyzer and never ships as a dependency. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>
</Project>
