<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneDocument.Documents.Tests</RootNamespace>
    <AssemblyName>RecursiveAI.OneDocument.Documents.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator of small Word binary files is shared with the fuzz seeds. -->
    <Compile Include="../Shared/DocBuilder.cs" Link="DocBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/VbaHubFixtures.cs" Link="VbaHubFixtures.cs" />
    <ProjectReference Include="../../src/OneDocument.Documents/OneDocument.Documents.csproj" />
  </ItemGroup>

</Project>
