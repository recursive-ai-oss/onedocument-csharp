<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Everything under src/ is a shipped package (or a generator). Packages with no content yet set IsPackable to false until the
       work that fills them turns it on. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PackageTags>docx;xlsx;pptx;ooxml;openxml;word;excel;powerpoint;office;rtf;odf;odt;ods;odp;xls;doc;ppt;xlsb;csv;pdf;epplus;closedxml;npoi;openxml-sdk;miniexcel;nativeaot;trimmable</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- 1.0.0 is the first release, so there is nothing to compare against yet. From 1.0.1 on, set PackageValidationBaselineVersion to the
         last published version (1.0.0 first) so a pack fails on an unintended breaking change. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>$(PackagePrefix)$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <!-- The public surface is frozen by a committed listing per assembly (PublicAPI.Shipped.txt; PublicAPI.Unshipped.txt for changes since the
       last release). The analyzer is build-only (PrivateAssets=all, nothing flows into the package) and any public type or member that is
       added, removed or changed without a listing edit fails the build. tools/api/update-public-api.py rewrites the listings. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE-MIT" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE-APACHE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
