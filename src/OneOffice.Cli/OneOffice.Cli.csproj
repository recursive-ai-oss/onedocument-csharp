<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oneoffice</AssemblyName>
    <RootNamespace>RecursiveAI.OneOffice.Cli</RootNamespace>
    <PackageId>$(PackagePrefix)OneOffice.Tool</PackageId>
    <Description>The oneoffice command-line tool. Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oneoffice</ToolCommandName>
    <IsPackable>true</IsPackable>
    <!-- A tool is not a library: no package validation and no AOT/trim analysis of its own. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOffice.All/OneOffice.All.csproj" />
  </ItemGroup>

</Project>
