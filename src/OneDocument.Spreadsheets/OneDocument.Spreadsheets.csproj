<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Spreadsheets for OneDocument: open, edit and save XLSX, XLSM, XLTX and Flat OPC workbooks with untouched parts kept byte-identical, read and write CSV and TSV, and stream rows and cells at constant memory; styles, number formats, tables, conditional formatting, data validation and defined names.</Description>
    <PackageTags>$(PackageTags);spreadsheet;xlsm;tsv;streaming;exceldatareader;sylvan</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Spreadsheets.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package carries its own readme instead of the repository-wide one. -->
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../OneDocument.Schema/OneDocument.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build assets travel in the package and are compiled into the application that references it, not into this library. -->
    <Compile Remove="build/**" />
    <None Include="build/RecursiveAI.OneDocument.Spreadsheets.targets;build/RecursiveAI.OneDocument.Spreadsheets.cs" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
