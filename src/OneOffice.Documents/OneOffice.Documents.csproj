<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Word-processing documents for OneOffice: open, edit and save DOCX, DOCM, DOTX, DOTM and Flat OPC with untouched parts kept byte-identical; styles, numbering, tables, sections, fields, notes, comments, revisions and content controls.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package carries its own readme instead of the repository-wide one. -->
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOffice/OneOffice.csproj" />
    <ProjectReference Include="../OneOffice.Schema/OneOffice.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build assets travel in the package and are compiled into the application that references it, not into this library. -->
    <Compile Remove="build/**" />
    <None Include="build/RecursiveAI.OneOffice.Documents.targets;build/RecursiveAI.OneOffice.Documents.cs" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
