<Project>
  <!-- Adds a module initializer to the consuming C# project that registers this package's formats with the default registry.
       It is a plain source file, not reflection or assembly scanning: the trimmer and NativeAOT keep only the kinds an application
       references. -->
  <ItemGroup Condition="'$(Language)' == 'C#' and '$(OneOfficeAutoRegister)' != 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)RecursiveAI.OneOffice.Documents.cs" Visible="false" />
  </ItemGroup>
</Project>
