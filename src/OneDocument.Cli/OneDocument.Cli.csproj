<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onedocument</AssemblyName>
    <RootNamespace>RecursiveAI.OneDocument.Cli</RootNamespace>
    <PackageId>$(PackagePrefix)OneDocument.Tool</PackageId>
    <Description>The onedocument command-line tool. Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onedocument</ToolCommandName>
    <IsPackable>true</IsPackable>
    <!-- A tool is not a library: no package validation and no AOT/trim analysis of its own. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument.All/OneDocument.All.csproj" />
  </ItemGroup>

  <!-- The tool references the kind projects directly, so it takes their registration files the way a package reference would. -->
  <Import Project="../OneDocument.Documents/build/RecursiveAI.OneDocument.Documents.targets" />
  <Import Project="../OneDocument.Spreadsheets/build/RecursiveAI.OneDocument.Spreadsheets.targets" />

</Project>
