<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Layout and rendering of documents, workbooks and presentations to tagged PDF and PNG for OneDocument, with its own Office layout engine, charts, SmartArt, equations and metafile drawing.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneRender" />
    <PackageReference Include="RecursiveAI.OneRender.Pdf" />
    <PackageReference Include="RecursiveAI.OneRender.Image" />
    <PackageReference Include="RecursiveAI.OneRender.Fonts" />
    <PackageReference Include="RecursiveAI.OneRender.Fonts.Noto.Math" />
    <PackageReference Include="RecursiveAI.OneFont" />
    <PackageReference Include="RecursiveAI.OneImage" />
    <PackageReference Include="RecursiveAI.OneImage.Text" />
    <PackageReference Include="RecursiveAI.OneImage.Metafile" />
    <PackageReference Include="RecursiveAI.OneImage.Svg" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <Compile Remove="build/**" />
    <None Include="build/RecursiveAI.OneDocument.Rendering.targets;build/RecursiveAI.OneDocument.Rendering.cs" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../OneDocument.Documents/OneDocument.Documents.csproj" />
    <ProjectReference Include="../OneDocument.Spreadsheets/OneDocument.Spreadsheets.csproj" />
    <ProjectReference Include="../OneDocument.Presentations/OneDocument.Presentations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Rendering.Tests" />
  </ItemGroup>

</Project>
