<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Metapackage that brings in every OneDocument package.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../OneDocument.Documents/OneDocument.Documents.csproj" />
    <ProjectReference Include="../OneDocument.Spreadsheets/OneDocument.Spreadsheets.csproj" />
    <ProjectReference Include="../OneDocument.Presentations/OneDocument.Presentations.csproj" />
    <ProjectReference Include="../OneDocument.Schema/OneDocument.Schema.csproj" />
    <ProjectReference Include="../OneDocument.Rendering/OneDocument.Rendering.csproj" />
    <ProjectReference Include="../OneDocument.Cryptography/OneDocument.Cryptography.csproj" />
  </ItemGroup>

</Project>
