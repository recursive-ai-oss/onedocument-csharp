<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Metapackage that brings in every OneDocument package that has content (core, documents, spreadsheets, presentations, schema views and rendering).</Description>
    <IsPackable>true</IsPackable>
    <!-- A metapackage holds no assembly of its own: it only lists the packages it brings in. The placeholder file below stops the
         packer asking for a lib folder. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none: each package's build files (format registration) and analyzers must reach the application that references
         this metapackage; by default a project reference would hide them. -->
    <ProjectReference Include="../OneDocument/OneDocument.csproj" PrivateAssets="none" />
    <ProjectReference Include="../OneDocument.Documents/OneDocument.Documents.csproj" PrivateAssets="none" />
    <ProjectReference Include="../OneDocument.Spreadsheets/OneDocument.Spreadsheets.csproj" PrivateAssets="none" />
    <ProjectReference Include="../OneDocument.Presentations/OneDocument.Presentations.csproj" PrivateAssets="none" />
    <ProjectReference Include="../OneDocument.Schema/OneDocument.Schema.csproj" PrivateAssets="none" />
    <ProjectReference Include="../OneDocument.Rendering/OneDocument.Rendering.csproj" PrivateAssets="none" />
    <!-- OneDocument.Cryptography (signatures, encryption on write) is left out until it has content; it joins this list when it ships. -->
  </ItemGroup>

  <ItemGroup>
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

</Project>
