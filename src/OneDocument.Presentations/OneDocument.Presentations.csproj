<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Presentations for OneDocument: open, edit and save PPTX, PPTM, POTX, PPSX and Flat OPC with untouched parts kept byte-identical; slide masters, layouts and slides with placeholder inheritance, shapes, text, tables, notes, comments and sections; add, delete, duplicate and reorder slides.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Presentations.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package carries its own readme instead of the repository-wide one. -->
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../OneDocument.Schema/OneDocument.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build assets travel in the package and are compiled into the application that references it, not into this library. -->
    <Compile Remove="build/**" />
    <None Include="build/RecursiveAI.OneDocument.Presentations.targets;build/RecursiveAI.OneDocument.Presentations.cs" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
