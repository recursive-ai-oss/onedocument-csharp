<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Word-processing documents for OneDocument: open, edit and save DOCX, DOCM, DOTX, DOTM, Flat OPC, RTF and ODT with untouched parts kept byte-identical; read DOC and Word 2003 XML; import and export HTML and Markdown; styles, numbering, tables, sections, fields, notes, comments, revisions, content controls and mail merge.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package carries its own readme instead of the repository-wide one. -->
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneHtml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../OneDocument.Schema/OneDocument.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Layout updates fields with the mail-merge picture and comparison code instead of keeping a second copy. -->
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Rendering" />
    <!-- The Markdown parser is internal; its tests render the tree to HTML to compare it with the published specification examples. -->
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Documents.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build assets travel in the package and are compiled into the application that references it, not into this library. -->
    <Compile Remove="build/**" />
    <None Include="build/RecursiveAI.OneDocument.Documents.targets;build/RecursiveAI.OneDocument.Documents.cs" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
