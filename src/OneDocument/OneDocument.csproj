<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Core of OneDocument: packages, containers, markup and the shared contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Fuzz" />
    <!-- The binary-workbook formula layer builds and annotates formula trees (whitespace trivia, argument arrays). -->
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Spreadsheets" />
    <!-- The PowerPoint binary reader fills in the report of a VBA project removal; Markdown and HTML conversions share internal helpers. -->
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Presentations" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Documents" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneArchive" />
    <PackageReference Include="RecursiveAI.OneMath" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generators (template models and spreadsheet rows) travel inside this package, as an analyzer, and are not a reference of the library itself. -->
    <ProjectReference Include="../OneDocument.Generators/OneDocument.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="GeneratorOutput" />
  </ItemGroup>

  <!-- The generator is built by the ProjectReference above (ordering only). Its output is named by path rather than taken from the reference's
       output items, because resolving those items starts a build of the referenced projects, which a pack from the tested binaries must not do. -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(ArtifactsPath)/bin/OneDocument.Generators/$(Configuration.ToLowerInvariant())/RecursiveAI.OneDocument.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
