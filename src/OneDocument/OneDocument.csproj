<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Core of OneDocument: packages, containers, markup and the shared contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneDocument.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneArchive" />
    <PackageReference Include="RecursiveAI.OneMath" />
  </ItemGroup>

</Project>
