<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Metapackage that brings in every OneOffice package.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOffice/OneOffice.csproj" />
    <ProjectReference Include="../OneOffice.Documents/OneOffice.Documents.csproj" />
    <ProjectReference Include="../OneOffice.Spreadsheets/OneOffice.Spreadsheets.csproj" />
    <ProjectReference Include="../OneOffice.Presentations/OneOffice.Presentations.csproj" />
    <ProjectReference Include="../OneOffice.Schema/OneOffice.Schema.csproj" />
    <ProjectReference Include="../OneOffice.Rendering/OneOffice.Rendering.csproj" />
    <ProjectReference Include="../OneOffice.Cryptography/OneOffice.Cryptography.csproj" />
  </ItemGroup>

</Project>
