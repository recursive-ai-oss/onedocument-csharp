<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Workbooks (XLSX, XLSB, XLS, ODS, CSV) and the calculation engine for OneOffice.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneOffice.Spreadsheets.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneOffice.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOffice/OneOffice.csproj" />
  </ItemGroup>

</Project>
