<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RecursiveAI.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RecursiveAI.$(MSBuildProjectName)</RootNamespace>
    <Description>Read, write, calculate, template and render Word, Excel and PowerPoint documents (OOXML, legacy binary, RTF, ODF) in pure .NET. Not affiliated with Microsoft. Spreadsheets for OneOffice: open, edit and save XLSX, XLSM, XLTX and Flat OPC workbooks with untouched parts kept byte-identical, read and write CSV and TSV, and stream rows and cells at constant memory; styles, number formats, tables, conditional formatting, data validation and defined names.</Description>
    <PackageTags>$(PackageTags);spreadsheet;xlsm;tsv;streaming;exceldatareader;sylvan</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneOffice.Spreadsheets.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneOffice.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package carries its own readme instead of the repository-wide one. -->
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOffice/OneOffice.csproj" />
    <!-- The row-binding source generator travels inside this package, as an analyzer, and is not a reference of the library itself. -->
    <ProjectReference Include="../OneOffice.Generators/OneOffice.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="GeneratorOutput" />
  </ItemGroup>

  <!-- The generator is built by the ProjectReference above (ordering only). Its output is named by path rather than taken from the reference's
       output items, because resolving those items starts a build of the referenced projects, which `dotnet pack --no-build` forbids. -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(ArtifactsPath)/bin/OneOffice.Generators/$(Configuration.ToLowerInvariant())/RecursiveAI.OneOffice.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
