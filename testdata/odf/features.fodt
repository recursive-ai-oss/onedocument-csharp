   <text:p text:style-name="Text_20_body">Plain <text:span text:style-name="T1">red bold <text:span text:style-name="T2">nested sup</text:span></text:span>   three  spaces<text:tab/>tab<text:line-break/>after break <text:a xlink:type="simple" xlink:href="https://example.org/" text:style-name="Internet_20_link">a link</text:a> and <text:a xlink:href="mailto:a@example.org">mail</text:a>.<text:s text:c="2"/>End<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Footnote body.</text:p></text:note-body></text:note><text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Footnote">Endnote body.</text:p></text:note-body></text:note></text:p>
   <text:p text:style-name="P1">Centered, tinted and bordered <office:annotation office:name="__Annotation__1"><dc:creator>Rev</dc:creator><dc:date>2024-01-01T10:00:00</dc:date><meta:creator-initials>RV</meta:creator-initials><text:p>Comment text</text:p></office:annotation>with a comment<office:annotation-end office:name="__Annotation__1"/>.</text:p>
   <text:p text:style-name="Text_20_body">Tracked: kept <text:change-start text:change-id="ct1"/>added<text:change-end text:change-id="ct1"/> then <text:change text:change-id="ct2"/>and <text:change-start text:change-id="ct3"/>formatted<text:change-end text:change-id="ct3"/> text.</text:p>
   <text:p text:style-name="Text_20_body">Fields: page <text:page-number text:select-page="current">4</text:page-number> of <text:page-count>9</text:page-count>, ref <text:bookmark-ref text:reference-format="text" text:ref-name="intro">Introduction</text:bookmark-ref> on page <text:bookmark-ref text:reference-format="page" text:ref-name="intro">1</text:bookmark-ref>, title <text:title>Feature sheet</text:title>, fixed date <text:date text:fixed="true" text:date-value="2024-03-04">03/04/2024</text:date>.</text:p>
