<Project>
  <!-- Consumer apps reference the OneDocument packages as packages (from a local pack), the way an application does. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(ONEDOCUMENT_CONSUMER_FEED)</RestoreAdditionalProjectSources>
    <OneDocumentVersion>$(ONEDOCUMENT_CONSUMER_VERSION)</OneDocumentVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneDocument.Consumer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>
</Project>
