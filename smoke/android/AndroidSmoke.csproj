<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared smoke checks as an Android app, run in an x86_64 emulator (build/mobile/android-run.sh). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneDocument.Smoke</RootNamespace>
    <AssemblyName>AndroidSmoke</AssemblyName>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>org.recursiveai.onedocument.smoke</ApplicationId>
    <ApplicationTitle>OneDocument smoke</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
    <!-- A package the emulator installs directly, not an app bundle. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Set here, not on the command line: a global PublishAot would reach the library projects, which are plain net10.0. -->
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
  </ItemGroup>

  <Import Project="../mobile/Mobile.props" />

</Project>
