<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneDocument.Fuzz</RootNamespace>
    <AssemblyName>RecursiveAI.OneDocument.Fuzz</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" /><Using Include="System.IO" /><Using Include="System.Linq" /><Using Include="System.Collections.Generic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SmartArt target seeds itself from the generated diagrams the tests use. -->
    <Compile Include="../../tests/OneDocument.Rendering.Tests/SmartArtSamples.cs" Link="SmartArtSamples.cs" />
    <Compile Include="../../tests/OneDocument.Rendering.Tests/TestDocx.cs" Link="TestDocx.cs" />
    <Compile Include="../../tests/OneDocument.Rendering.Tests/TestPptx.cs" Link="TestPptx.cs" />
    <Compile Include="../../tools/ChartProbe/ChartSamples.cs" Link="ChartSamples.cs" />
    <Compile Include="../../tests/OneDocument.Rendering.Tests/DrawingSamples.cs" Link="DrawingSamples.cs" />
    <Compile Include="../../tests/Shared/DocBuilder.cs" Link="DocBuilder.cs" />
    <!-- The VBA targets seed themselves from the generated projects the tests use. -->
    <Compile Include="../../tests/Shared/VbaTestProject.cs" Link="VbaTestProject.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneDocument/OneDocument.csproj" />
    <ProjectReference Include="../../src/OneDocument.Documents/OneDocument.Documents.csproj" />
    <ProjectReference Include="../../src/OneDocument.Spreadsheets/OneDocument.Spreadsheets.csproj" />
    <ProjectReference Include="../../src/OneDocument.Presentations/OneDocument.Presentations.csproj" />
    <ProjectReference Include="../../src/OneDocument.Rendering/OneDocument.Rendering.csproj" />
  </ItemGroup>

</Project>
