<Project>

  <PropertyGroup Label="Name">
    <!-- The one place the project name lives. Assembly and namespace names stay RecursiveAI.$(LibName). -->
    <LibName>OneDocument</LibName>
    <!-- NuGet package IDs carry the publisher prefix; this is the only place it is written. -->
    <PackagePrefix>RecursiveAI.</PackagePrefix>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Build output stays out of the source folders. Set ONEDOCUMENT_ARTIFACTS to choose where; the default is artifacts/ at the
         repository root, which .gitignore covers. -->
    <ArtifactsPath Condition="'$(ONEDOCUMENT_ARTIFACTS)' != ''">$(ONEDOCUMENT_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONEDOCUMENT_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Language and analysis">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Safe, bounds-checked C# throughout. A file that needs unsafe code is named in the design notes, by exception. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Names, separators and number formats of spreadsheet locales come from our own tables, never from the host's culture data,
         so output does not depend on the machine and ICU is not needed (browser and AOT builds stay small). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible packages">
    <!-- Path mapping is for the packages only (projects under src/). Test projects keep real paths: some tests locate test data from
         [CallerFilePath], which a mapped path would break on CI. -->
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_SrcDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcDir>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' and $(_ProjectDir.StartsWith('$(_SrcDir)'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- The one place the package version lives; every package and the tool share it. -->
    <Version>0.1.0-preview.1</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onedocument-csharp</RepositoryUrl>
    <PackageProjectUrl>https://recursiveai.org/onedocument/</PackageProjectUrl>
  </PropertyGroup>

</Project>
